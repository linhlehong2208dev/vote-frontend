# Supabase (dùng anon key - an toàn để lộ ở frontend)
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# URL của vote-backend
VITE_API_BASE_URL=http://localhost:4000

# Chỉ để hiển thị gợi ý domain email trên form đăng nhập (không dùng để enforce)
VITE_ALLOWED_EMAIL_DOMAIN=rever.vn

# Số giây mặc định gợi ý cho MC khi bấm Bắt đầu
VITE_DEFAULT_DURATION_SECONDS=30

VITE_ADMIN_EMAILS=linhlh@rever.vn